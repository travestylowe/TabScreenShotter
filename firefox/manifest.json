{
  "manifest_version": 3,
  "name": "TabScreenShotter",
  "version": "1.0.0",
  "description": "Screenshots every image tab in the current window, cropped to image bounds.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "incognito": "spanning",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabscreenshotter@example.com",
      "strict_min_version": "109.0"
    }
  }
}
